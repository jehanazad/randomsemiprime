// Cloudflare deploy config for primetotem.com: index.html as a static asset plus the archive Worker.
// Deploy with `npx wrangler deploy` (CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID, or `npx wrangler login`).
// Files listed in .assetsignore are not uploaded. Schema for the D1 database is in schema.sql.
{
  "name": "randomsemiprime",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "randomsemiprime-archive", "database_id": "4ae6ef9d-cf62-48f2-86f4-67693dac8dfb" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Relay requests per cron run (every attempt counts): new rounds first, the rest backfills
    // older ones. The Workers free plan allows 50 external subrequests per invocation; paid
    // plans allow 10,000. CPU per cron run is 10 ms on the free plan, so keep this modest there.
    "SUBREQUEST_BUDGET": "45",
    // Rows per cron run whose stored n is re-derived after a spec change (no relay requests; each
    // is one D1 row write). D1 free allows 100,000 row writes per day, and new and backfilled rounds
    // already use about 65,000, so keep this near 20 there; on a paid plan 2000 is fine.
    "MIGRATE_BATCH": "20"
  },
  // primetotem.com is the site; the other hosts are kept so the Worker can redirect them to it.
  "routes": [
    { "pattern": "primetotem.com", "custom_domain": true },
    { "pattern": "www.primetotem.com", "custom_domain": true },
    { "pattern": "randomsemiprime.com", "custom_domain": true },
    { "pattern": "www.randomsemiprime.com", "custom_domain": true }
  ]
}
